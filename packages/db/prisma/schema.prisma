// The data model (plan §2, D10). Database names are snake_case; Prisma maps them to camelCase.
// Numeric ranges (agent_count 1–20, …) are CHECK constraints added by hand in the first migration:
// Prisma's schema language can't express them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Declaration order is the Postgres enum order, so max(risk) = most severe.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_level")
}

enum AssessmentStatus {
  STARTING
  RUNNING
  AGGREGATING
  AWAITING_APPROVAL
  PERSISTING
  COMPLETED
  REJECTED
  REJECTED_INPUT
  CANCELLED
  FAILED

  @@map("assessment_status")
}

enum AgentStatus {
  QUEUED
  STARTING
  RUNNING
  COMPLETED
  FAILED
  LOST
  STOPPED

  @@map("agent_status")
}

enum LostReason {
  START_FAILED
  NOT_FOUND
  NO_PROGRESS
  CEILING

  @@map("lost_reason")
}

enum Decision {
  APPROVE
  REJECT

  @@map("decision")
}

/// One row per run.
model Assessment {
  /// Generated by the browser (D12).
  id                  String           @id @db.Uuid
  targetDomain        String           @map("target_domain")
  agentCount          Int              @map("agent_count")
  windowSize          Int              @default(2) @map("window_size")
  status              AssessmentStatus @default(STARTING)
  stallTimeoutS       Int              @default(60) @map("stall_timeout_s")
  maxAgentDurationS   Int              @default(300) @map("max_agent_duration_s")
  /// The R3 retry switch (D15).
  failFirstAttempts   Int              @default(0) @map("fail_first_attempts")
  cancelRequestedAt   DateTime?        @map("cancel_requested_at") @db.Timestamptz
  decision            Decision?
  decisionRequestedAt DateTime?        @map("decision_requested_at") @db.Timestamptz
  /// Summary, written by aggregate.
  uniqueDomains       Int?             @map("unique_domains")
  criticalCount       Int?             @map("critical_count")
  highCount           Int?             @map("high_count")
  mediumCount         Int?             @map("medium_count")
  lowCount            Int?             @map("low_count")
  failureReason       String?          @map("failure_reason")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agents            AssessmentAgent[]
  discoveredDomains DiscoveredDomain[]

  @@index([createdAt(sort: Desc)], map: "assessments_created_at_idx")
  @@map("assessments")
}

/// One row per agent, all created at submit.
model AssessmentAgent {
  id              BigInt      @id @default(autoincrement())
  assessmentId    String      @map("assessment_id") @db.Uuid
  agentIndex      Int         @map("agent_index")
  technique       String
  /// Set once the start succeeds.
  scanId          String?     @map("scan_id")
  status          AgentStatus @default(QUEUED)
  /// Set with LOST.
  lostReason      LostReason? @map("lost_reason")
  /// Set when we stop it; false = "stop unconfirmed" (D6).
  stopConfirmed   Boolean?    @map("stop_confirmed")
  progress        Float       @default(0) @db.Real
  discoveredCount Int?        @map("discovered_count")
  /// Pod name of the worker handling it.
  worker          String?
  startedAt       DateTime?   @map("started_at") @db.Timestamptz
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assessment        Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stagedDiscoveries StagedDiscovery[]

  @@unique([assessmentId, agentIndex])
  @@index([assessmentId], map: "assessment_agents_assessment_idx")
  @@map("assessment_agents")
}

/// One row per finding, kept for every run.
model StagedDiscovery {
  assessmentId String    @map("assessment_id") @db.Uuid
  agentIndex   Int       @map("agent_index")
  domain       String
  /// As this agent rated it.
  risk         RiskLevel
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  agent AssessmentAgent @relation(fields: [assessmentId, agentIndex], references: [assessmentId, agentIndex], onDelete: Cascade)

  @@id([assessmentId, agentIndex, domain])
  @@map("staged_discoveries")
}

/// One row per subdomain per run, written only by approve.
model DiscoveredDomain {
  id           BigInt    @id @default(autoincrement())
  assessmentId String    @map("assessment_id") @db.Uuid
  domain       String
  /// The most severe across agents.
  risk         RiskLevel
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domain])
  @@index([assessmentId], map: "discovered_domains_assessment_idx")
  @@map("discovered_domains")
}
