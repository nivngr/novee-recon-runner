{
  "name": "recon-runner",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/api",
    "apps/worker",
    "apps/web",
    "packages/contracts",
    "packages/db"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
